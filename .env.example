# ==============================================================================
# DentiFlow Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values appropriate for your environment.
# ==============================================================================

# STABLE FLASK / EXPRESS AUTHENTICATION SECRETS (Do NOT leave empty in production)
FLASK_SECRET_KEY="dentiflow_stable_production_secret_key_change_me"
SESSION_SECRET="dentiflow_session_secret_change_me"
PASSWORD_RESET_SECRET="dentiflow_password_reset_secret_change_me"

# SERVER & APPLICATION URL
APP_URL="http://localhost:3000"
API_PORT="3001"

# EMAIL PROVIDER CONFIGURATION (Resend Primary)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
EMAIL_FROM="Dentiflow <onboarding@resend.dev>"

# SMTP FALLBACK CONFIGURATION (Optional - used if RESEND_API_KEY is unset)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_SECURE="false"

# GEMINI AI API (Required for AI Odontogram & Clinical Assistant)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# RAZORPAY PAYMENT GATEWAY CREDENTIALS (Optional)
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
